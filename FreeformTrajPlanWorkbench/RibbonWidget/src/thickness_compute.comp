#version 430 core
#define MODEL_SHADER_REVISION 4

layout(local_size_x = 256) in;

struct SurfaceSample { vec4 position; vec4 normal; };
struct SprayPoint { vec4 positionTime; vec4 axisX; vec4 axisY; vec4 axisZ; ivec4 meta; };

layout(std430, binding = 0) readonly buffer SurfaceBuffer { SurfaceSample surfaces[]; };
layout(std430, binding = 1) buffer ThicknessBuffer { float thickness[]; };
layout(std430, binding = 2) readonly buffer SprayBuffer { SprayPoint sprays[]; };
layout(std430, binding = 3) readonly buffer CellOffsetBuffer { uint cellOffsets[]; };
layout(std430, binding = 4) readonly buffer CellSprayBuffer { uint cellSprays[]; };

uniform uint surfaceCount;
uniform uint sprayCount;
uniform int modelType;
uniform float gaussianSigma;
uniform float gaussianPeak;
uniform float gaussianEfficiency;
uniform float depositionGamma;
uniform float depositionAlphaX;
uniform float depositionAlphaY;
uniform float depositionBeta1;
uniform float depositionBeta2;
uniform float depositionBeta3;
uniform float depositionKEpsilon;
uniform float depositionTMax;
uniform float depositionDelta;
uniform ivec3 spatialGridDim;
uniform vec3 spatialGridMin;
uniform float spatialCellSize;
uniform int spatialCellRadius;

const float PI = 3.141592653589793;
const float RAD2DEG = 57.29577951308232;
const float ANGULAR_WIDTH = 2.0;
vec3 safeNormalize(vec3 v, vec3 fallback) { float n=length(v); return n>1e-8?v/n:fallback; }

float gaussianNorm(float d) { return gaussianSigma < 1e-6 ? 0.0 : exp(-(d*d)/(2.0*gaussianSigma*gaussianSigma)); }
float model420DistanceEfficiency(float d) { float r=log(d/106.8615)/0.0839; return 0.9789+0.1456*exp(-(r*r)); }
float model420Deposit(float actualDistance,float axialDistance,float u,float v,float cosineIncidence) {
    if (actualDistance<=0.0 || axialDistance<=0.0 || cosineIncidence<=0.0) return 0.0;
    float phi=atan(u/axialDistance), psi=atan(v/axialDistance);
    float phiRot=cos(-0.04494047503)*phi+sin(-0.04494047503)*psi;
    float psiRot=-sin(-0.04494047503)*phi+cos(-0.04494047503)*psi;
    float gaussian=exp(-0.5*(pow((phiRot-0.0002884115775)/0.02793467718,2.0)+pow((psiRot+0.002083376641)/0.03265327731,2.0)));
    float distanceScale=(120.0*120.0/(actualDistance*actualDistance))*model420DistanceEfficiency(actualDistance)/model420DistanceEfficiency(120.0);
    float peak=0.5953252911/4.0;
    return peak*gaussian*distanceScale*cosineIncidence;
}
float zigongDistance(float d) { return d<=0.0||d>500.0?0.0:max(0.0,7.80164e-05*d*d-3.33740e-02*d+4.14196); }
float zigongAngle(float a) { return max(0.0,3.84153e-05*a*a+2.70967e-03*a+0.43915); }
float zigongSpatial(float a,float p) {
    float da=a+0.0551, dp=p+1.4089, c=cos(1.5480), s=sin(1.5480); float u=da*c+dp*s, v=-da*s+dp*c, vb=v-0.009036*u*u;
    float sh=max(0.0,1.0-pow(abs(u/13.2733),2.8179)-pow(abs(vb/12.0367),1.7774));
    return sh<=0.0?0.0:max(0.0,1.0256*pow(sh,20.0)*(1.0+1.3640*(u/13.2733)));
}
float safePow(float base, float exponent) { return pow(max(base, 1e-8), exponent); }
bool depositionAxes(float h, out float a, out float b) {
    float gamma=radians(depositionGamma), ax=radians(depositionAlphaX), ay=radians(depositionAlphaY);
    float denX=2.0*cos(gamma-ax)*cos(gamma+ax), denY=2.0*cos(gamma-ay)*cos(gamma+ay);
    if (abs(denX)<1e-6 || abs(denY)<1e-6) return false;
    a=h*cos(gamma)*sin(2.0*ax)/denX;
    b=h*cos(gamma)*sin(2.0*ay)/denY;
    return a>1e-6 && b>1e-6;
}
float doubleBetaSpatial(float x, float y, float h) {
    float a,b; if (!depositionAxes(h,a,b)) return 0.0;
    float ys=y+b*0.5, u=ys*ys/(b*b);
    if (ys<=0.0 || u>=1.0 || x*x/(a*a)+u>=1.0) return 0.0;
    float v=x*x/(a*a*(1.0-u)); if (v>=1.0) return 0.0;
    float eH=832.6255*safePow(h,-1.4293);
    float eGamma=abs(depositionGamma)<1e-6?0.989:(-0.0732*safePow(abs(depositionGamma),-9.5608)+0.989);
    float b23=depositionBeta2+depositionBeta3-2.0;
    if (depositionBeta1<=1.0 || depositionBeta2<=1.0 || depositionBeta3<=1.0 || b23<=0.0) return 0.0;
    float kBeta=safePow(b23,b23)/(safePow(depositionBeta3-1.0,depositionBeta3-1.0)*safePow(depositionBeta2-1.0,depositionBeta2-1.0));
    return max(0.0,kBeta*depositionKEpsilon*eH*eGamma*safePow(u,depositionBeta3-1.0)*safePow(1.0-u,depositionBeta2-1.0)*safePow(1.0-v,depositionBeta1-1.0));
}
float calibratedGaussianSpatial(float x, float y, float h, float theta) {
    float A=(548.58+6.2625*theta-1.4996*h)*0.25e-3;
    float a=(21510.0-84.8657*theta-13.871*h)*1e-3;
    float b=(3697.8-0.4453*theta+13.7499*h)*1e-3;
    float de=(-3.4439+0.0547*theta+0.017*h)/8.7;
    return (abs(a)<1e-6 || abs(b)<1e-6)?0.0:max(0.0,A*de*exp(-x*x/(a*a)-y*y/(b*b)));
}
float skewedDoubleBetaSpatial(float x, float y, float h) {
    float a,b; if (!depositionAxes(h,a,b) || depositionBeta1<=1.0 || depositionBeta2<=1.0) return 0.0;
    float u=x*x/(a*a), v=y*y/(b*b); if (u>=1.0 || v/(1.0-u)>=1.0) return 0.0;
    return max(0.0,2.0*depositionTMax*safePow(1.0-u,depositionBeta1-1.0)*safePow(1.0-v/(1.0-u),depositionBeta2-1.0)*(1.0+depositionDelta*(y/b)*(1.0-v)));
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= surfaceCount) return;

    vec3 sp = surfaces[index].position.xyz;
    vec3 sn = safeNormalize(surfaces[index].normal.xyz, vec3(0.0,0.0,1.0));
    float total = 0.0;
    ivec3 centerCell = ivec3(floor((sp - spatialGridMin) / spatialCellSize));
    centerCell = clamp(centerCell, ivec3(0), spatialGridDim - ivec3(1));
    ivec3 firstCell = max(centerCell - ivec3(spatialCellRadius), ivec3(0));
    ivec3 lastCell = min(centerCell + ivec3(spatialCellRadius), spatialGridDim - ivec3(1));
    for (int z = firstCell.z; z <= lastCell.z; ++z)
    for (int y = firstCell.y; y <= lastCell.y; ++y)
    for (int x = firstCell.x; x <= lastCell.x; ++x) {
        uint cell = uint(x + spatialGridDim.x * (y + spatialGridDim.y * z));
        for (uint candidate = cellOffsets[cell]; candidate < cellOffsets[cell + 1u]; ++candidate) {
        uint i = cellSprays[candidate];
        if (i >= sprayCount) continue;
        SprayPoint cur, intervalEnd;
        if (modelType==5) {
            if (i+1u >= sprayCount) continue;
            cur=sprays[i]; intervalEnd=sprays[i+1u];
        } else {
            if (i == 0u) continue;
            cur=sprays[i]; intervalEnd=sprays[i-1u];
        }
        if (cur.meta.x != intervalEnd.meta.x) continue;
        float dt=modelType==5 ? intervalEnd.positionTime.w-cur.positionTime.w : cur.positionTime.w-intervalEnd.positionTime.w; if (dt<=1e-9) continue;
        vec3 gun=cur.positionTime.xyz, dir=safeNormalize(cur.axisZ.xyz, vec3(0.0,0.0,1.0));
        float sd=abs(cur.axisZ.w); vec3 to=sp-gun;
        bool calibrated=(modelType==4 || modelType==5);
        bool analytic=(modelType==6 || modelType==7 || modelType==8);
        // The three analytic models are defined in the nozzle-local frame.
        // They must use the nozzle as their source, not the Gaussian
        // footprint center used by the legacy distribution.
        vec3 source=(calibrated || analytic)?gun:(gun+dir*sd); vec3 delta=sp-source; float dsq=dot(delta,delta); if (dsq<1e-12) continue;
        float dist=sqrt(dsq);
        if (calibrated) {
            float axial=dot(delta,dir); if (axial<=0.0) continue; vec3 tr=delta-axial*dir;
            if (modelType!=5 && dot(tr,tr)>axial*axial*0.171572875) continue;
            vec3 srcX=safeNormalize(cur.axisX.xyz, vec3(1.0,0.0,0.0)), srcY=safeNormalize(cur.axisY.xyz, vec3(0.0,1.0,0.0));
            vec3 major=-srcY, minor=srcX; float lx=dot(delta,major), ly=dot(delta,minor), lz=dot(delta,dir);
            float safeZ=abs(lz)<1e-3?(lz<0.0?-1e-3:1e-3):lz;
            vec3 vts=safeNormalize(-delta,-dir); float ci=dot(sn,vts); if (ci<=0.0) continue;
            float theta=acos(clamp(ci,-1.0,1.0))*RAD2DEG, angle=90.0-theta;
            if (modelType==5) { total += dt*model420Deposit(dist,axial,lx,ly,ci); }
            else { float dd=zigongDistance(dist), ad=zigongAngle(angle), wy=1.0+0.2*sin(theta/RAD2DEG); float aa=atan(lx/ANGULAR_WIDTH,safeZ)*RAD2DEG; float pp=atan((ly/wy)/ANGULAR_WIDTH,safeZ)*RAD2DEG; total += dt*dd*ad*zigongSpatial(aa,pp); }
        } else if (analytic) {
            vec3 gunToSample=sp-gun;
            float gunDistance=length(gunToSample); if (gunDistance<1e-6) continue;
            float axialHeight=dot(gunToSample,dir); if (axialHeight<=1e-6) continue;
            vec3 transverse=gunToSample-axialHeight*dir;
            // The fitted Gaussian has non-zero tails everywhere. Without a
            // physical cone limit, its tiny tails are amplified by 1/a2^3
            // near a tangential ray and produce unrealistically huge values.
            if (dot(transverse,transverse)>axialHeight*axialHeight*0.171572875) continue;
            vec3 localX=safeNormalize(cur.axisX.xyz,vec3(1.0,0.0,0.0));
            vec3 localY=safeNormalize(cross(dir,localX),vec3(0.0,1.0,0.0));
            float localXCoord=dot(gunToSample,localX), localYCoord=dot(gunToSample,localY);
            // Mesh winding is not a physical coating-side contract. The CPU
            // path uses the same two-sided incidence for visible surfaces.
            float ci=abs(dot(sn,-gunToSample/gunDistance)); if (ci<=1e-6) continue;
            float theta=90.0-acos(clamp(ci,-1.0,1.0))*RAD2DEG;
            float f=modelType==6?doubleBetaSpatial(localXCoord,localYCoord,axialHeight):
                    (modelType==7?calibratedGaussianSpatial(localXCoord,localYCoord,axialHeight,theta):skewedDoubleBetaSpatial(localXCoord,localYCoord,axialHeight));
            float a2=axialHeight/gunDistance; if (f<=0.0 || a2<1e-6) continue;
            float h=max(sd,1e-6);
            total += f*(h*h*ci/(gunDistance*gunDistance*a2*a2*a2))*dt;
        } else {
            // The Gaussian distribution is measured on the footprint plane,
            // but incidence and spray direction must be measured from the
            // physical nozzle. Using delta here makes both vectors tangential
            // on a flat receiving surface, which reduces the deposit to zero.
            float lateralDistance=sqrt(dsq);
            vec3 gunToSurface=sp-gun;
            float gunDistance=length(gunToSurface);
            if (gunDistance < 1e-6) continue;
            vec3 lightDir=-gunToSurface/gunDistance;
            float diffuse=max(0.0,dot(sn,lightDir));
            float angularFactor=max(0.0,dot(lightDir,-dir));
            total += gaussianPeak*gaussianEfficiency*diffuse*angularFactor
                *dt*gaussianNorm(lateralDistance);
        }
        }
    }
    thickness[index]=total;
}
