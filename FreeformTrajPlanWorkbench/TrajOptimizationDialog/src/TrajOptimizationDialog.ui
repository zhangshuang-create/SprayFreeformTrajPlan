                  <width>0</width>
                  <height>40</height>
                 </size>
                </property>
                <property name="styleSheet">
                 <string notr="true">QPushButton {
    background-color: #0f6f8f;
    color: #ffffff;
    border: 1px solid #0b526a;
    font-weight: 700;
    font-size: 14px;
    border-radius: 2px;
}
QPushButton:hover { background-color: #0b5f7c; }
QPushButton:pressed { background-color: #084b61; }
