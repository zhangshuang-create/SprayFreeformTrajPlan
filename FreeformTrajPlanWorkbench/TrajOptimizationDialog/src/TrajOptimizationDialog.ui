  <property name="styleSheet">
   <string notr="true">/* Industrial control-room theme */
QDialog#TrajOptimizationDialogClass {
    background-color: #dfe5ea;
}

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 12px;
    color: #1f2b33;
}

QFrame#headerFrame {
    background-color: #14212b;
    border: none;
    border-bottom: 1px solid #334652;
}

QFrame#headerAccentFrame {
    background-color: #f2a900;
    border: none;
}

QFrame#statusStripFrame {
    background-color: #1d2e3a;
    border: 1px solid #3b5361;
    border-radius: 2px;
}

QFrame#trajectoryInfoFrame,
QFrame#workpieceInfoFrame,
QFrame#toolInfoFrame,
QFrame#progressPanelFrame {
    background-color: #eef3f6;
    border: 1px solid #c7d2da;
    border-left: 4px solid #2f6f95;
    border-radius: 2px;
}

QFrame#footerFrame {
    background-color: #f7f9fa;
    border-top: 1px solid #b9c5cc;
}

QLabel {
    color: #2d3c45;
    background: transparent;
}

QLabel#headerTitleLabel {
    color: #f7fbff;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#headerSubtitleLabel {
    color: #aebfc9;
    font-size: 12px;
}

QLabel#headerTagLabel {
    color: #151f27;
    background-color: #f2a900;
    border-radius: 2px;
    padding: 4px 10px;
    font-weight: 700;
}

QLabel#workflowLabel {
    color: #d7e2e8;
    font-weight: 600;
}

QLabel#parameterHintLabel,
QLabel#resultHintLabel {
    color: #60717b;
}

QLabel#trajectoryPointCountLabel,
QLabel#workpieceNameLabel,
QLabel#toolNameLabel,
QLabel#collisionProgressInfoLabel {
    color: #1b3646;
    font-weight: 700;
}

QLabel#safePointsLabel,
QLabel#collisionPointsLabel,
QLabel#safetyRateLabel {
    background-color: #f8fbfc;
    border: 1px solid #c7d2da;
    border-radius: 2px;
    padding: 10px 12px;
    font-weight: 700;
    font-size: 14px;
}

QGroupBox {
    background-color: #f8fafb;
    border: 1px solid #b9c5cc;
    border-top: 3px solid #304858;
    border-radius: 2px;
    margin-top: 20px;
    padding: 18px 14px 14px 14px;
    font-weight: 700;
    color: #182832;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 0px;
    padding: 4px 12px;
    background-color: #304858;
    color: #ffffff;
    border-radius: 1px;
}

QGroupBox#trajectoryImportGroup {
    border-top-color: #3f6f8f;
}

QGroupBox#workpieceImportGroup,
QGroupBox#toolImportGroup {
    border-top-color: #596a74;
}

QGroupBox#collisionDetectionGroup {
    border-top-color: #0f6f8f;
}

QGroupBox#collisionDetectionGroup::title {
    background-color: #0f6f8f;
}

QGroupBox#collisionResultGroup {
    margin-top: 14px;
    padding-top: 16px;
}

QLineEdit,
QComboBox,
QDoubleSpinBox,
QSpinBox {
    background-color: #ffffff;
    border: 1px solid #9daeb8;
    border-radius: 2px;
    padding: 5px 8px;
    min-height: 26px;
    selection-background-color: #0f6f8f;
    selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QDoubleSpinBox:focus,
QSpinBox:focus {
    border: 1px solid #0f6f8f;
    background-color: #fbfdfe;
}

QLineEdit:read-only {
    background-color: #eef3f6;
    color: #43545e;
}

QComboBox:disabled,
QDoubleSpinBox:disabled,
QLineEdit:disabled {
    background-color: #e3e9ed;
    color: #8898a2;
}

QComboBox::drop-down {
    width: 28px;
    border-left: 1px solid #c0ccd3;
}

QComboBox QAbstractItemView {
    border: 1px solid #9daeb8;
    background-color: #ffffff;
    selection-background-color: #0f6f8f;
    selection-color: #ffffff;
    outline: none;
}

QPushButton {
    background-color: #344957;
    color: #ffffff;
    border: 1px solid #263945;
    border-radius: 2px;
    padding: 6px 14px;
    min-height: 28px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #263945;
}

QPushButton:pressed {
    background-color: #172630;
}

QPushButton:disabled {
    background-color: #d1d9de;
    border-color: #c1ccd3;
    color: #8998a1;
}

QRadioButton,
QCheckBox {
    color: #2d3c45;
    spacing: 8px;
    background: transparent;
}

QRadioButton::indicator,
QCheckBox::indicator {
    width: 15px;
    height: 15px;
}

QProgressBar {
    border: 1px solid #9daeb8;
    border-radius: 2px;
    background-color: #dbe4e9;
    text-align: center;
    color: #14212b;
    min-height: 24px;
    font-weight: 700;
}

QProgressBar::chunk {
    background-color: #0f6f8f;
    border-radius: 1px;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea &gt; QWidget &gt; QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: #dfe5ea;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #95a6b0;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #6f838e;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}</string>
